{
  "name": "custom-email-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Connect Zoho Mail and guide Namecheap DNS setup to create custom email through MCP.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "plugin:url": "node scripts/set-plugin-url.mjs",
    "smoke:oauth": "node scripts/smoke-oauth.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "fast-xml-parser": "^5.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
