PUBLIC_URL=http://localhost:3000

# Encrypts provider credentials, signs browser identity, and protects OAuth state.
# Use 32 random bytes as base64. Required outside local development.
MASTER_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64

# Create a server-based app in the Zoho API Console.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DATA_CENTER=com

# Local encrypted state. Use a persistent disk when hosting the preview.
DATA_FILE=.data/state.json
